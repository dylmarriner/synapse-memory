{
  "id": "nexus-memory",
  "name": "Nexus Memory",
  "description": "Unified long-term memory via Nexus — recall, lessons, entity graph, rolling summaries, consolidation, reflection, context reconstruction, and trust scoring.",
  "kind": "memory",
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "memory_recall",
      "memory_store",
      "memory_forget",
      "memory_consolidate",
      "memory_reflect",
      "memory_context",
      "memory_confirm",
      "memory_contradict"
    ]
  },
  "capabilities": {
    "network": {
      "allow": [
        "http://100.93.75.87:7777",
        "http://100.93.75.87:7777/*",
        "http://localhost:7777",
        "http://localhost:7777/*",
        "http://127.0.0.1:7777",
        "http://127.0.0.1:7777/*"
      ]
    }
  },
  "uiHints": {
    "nexusUrl": {
      "label": "Nexus URL",
      "placeholder": "http://100.93.75.87:7777"
    },
    "nexusSecret": {
      "label": "Nexus API Secret",
      "sensitive": true
    },
    "agentId": {
      "label": "Agent ID",
      "placeholder": "openclaw"
    },
    "autoRecall": {
      "label": "Auto-Recall",
      "help": "Expose Nexus recall guidance and tools in the memory prompt."
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "nexusUrl": {
        "type": "string"
      },
      "nexusSecret": {
        "type": "string"
      },
      "agentId": {
        "type": "string"
      },
      "autoCapture": {
        "type": "boolean"
      },
      "autoRecall": {
        "type": "boolean"
      }
    }
  }
}
