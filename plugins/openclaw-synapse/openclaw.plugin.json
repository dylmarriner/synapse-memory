{
  "id": "synapse",
  "activation": {
    "onStartup": true
  },
  "name": "Synapse Memory",
  "description": "Enterprise-grade multi-tenant AI memory backbone — persistent, cross-device, event-sourced memory for agents and tools.",
  "contracts": {
    "tools": [
      "synapse_store",
      "synapse_retrieve",
      "synapse_update",
      "synapse_delete",
      "synapse_context",
      "synapse_rank",
      "synapse_embed",
      "synapse_compress",
      "synapse_memory"
    ]
  },
  "toolMetadata": {
    "synapse_store": { "optional": false },
    "synapse_retrieve": { "optional": false },
    "synapse_update": { "optional": true },
    "synapse_delete": { "optional": true },
    "synapse_context": { "optional": false },
    "synapse_rank": { "optional": true },
    "synapse_embed": { "optional": true },
    "synapse_compress": { "optional": true },
    "synapse_memory": { "optional": true }
  },
  "skills": ["./skills"],
  "uiHints": {
    "serverUrl": {
      "label": "Synapse Server URL",
      "help": "MCP endpoint of the Synapse memory server (e.g. http://100.91.55.113:8765/mcp)"
    },
    "apiKey": {
      "label": "API Key",
      "help": "Synapse tenant API key (leave empty for single-tenant/default mode)"
    },
    "defaultProjectKey": {
      "label": "Default Project Key",
      "help": "Default project key used when none is specified in tool calls"
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "serverUrl": {
        "type": "string",
        "format": "uri",
        "default": "http://100.91.55.113:8765/mcp",
        "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://"
      },
      "apiKey": {
        "type": "string",
        "default": ""
      },
      "defaultProjectKey": {
        "type": "string",
        "default": "default"
      },
      "maxRetrieveResults": {
        "type": "number",
        "minimum": 1,
        "maximum": 100,
        "default": 10
      }
    }
  }
}
