# ── Global rules writers (project = $HOME, not cwd) ──────────────────────
# These install the canonical Nexus rules block at the agent's GLOBAL config
# location so the rules apply to every project, every workspace. Use --local
# to force project-level (cwd) instead for agents that support both.

def _write_global_rules(path: Path, agent_name: str, *, local: bool = False) -> InstallResult:
    """Write canonical Nexus rules to a global markdown file."""
    if not _read_rules():
        return InstallResult(False, "Canonical rules file missing",
                             detail=f"Expected {RULES_PATH}")
    path.parent.mkdir(parents=True, exist_ok=True)
    if append_rule_block(path, "## Nexus Memory"):
        scope = "project" if local else "global"
        return InstallResult(True, f"Wrote rules to {path} ({scope})",
                             detail=str(path), changed_paths=[str(path)])
    return InstallResult(True, f"Rules already present in {path}",
                         detail=str(path), changed_paths=[])


def install_rules_claude_code(*, local: bool = False) -> InstallResult:
    target = HOME / ".claude" / "CLAUDE.md"
    if local:
        target = Path.cwd() / "CLAUDE.md"
    return _write_global_rules(target, "claude-code", local=local)


def install_rules_gemini_cli(*, local: bool = False) -> InstallResult:
    target = HOME / ".gemini" / "GEMINI.md" if not local else Path.cwd() / "GEMINI.md"
    return _write_global_rules(target, "gemini-cli", local=local)


def install_rules_qwen_code(*, local: bool = False) -> InstallResult:
    target = HOME / ".qwen" / "QWEN.md" if not local else Path.cwd() / "QWEN.md"
    return _write_global_rules(target, "qwen-code", local=local)


def install_rules_codex_cli(*, local: bool = False) -> InstallResult:
    # Codex reads global ~/.codex/AGENTS.md and project AGENTS.md
    target = HOME / ".codex" / "AGENTS.md" if not local else Path.cwd() / "AGENTS.md"
