# VS Code-like extension installers (Cline/Roo/Kilo/Kade in Windsurf/Antigravity/Trae/PearAI)
VSCODE_LIKE_AGENTS: list[AgentDef] = []

def _make_vscode_like(app_dir: str, agent_name: str) -> AgentDef:
    """Generate a generic installer for Cline in a VS Code-like IDE."""
    def _install() -> InstallResult:
        return install_vscode_like(
            app_dir, "saoudrizwan.claude-dev",
            "settings/cline_mcp_settings.json", agent_name,
        )
    def _detect() -> bool:
        return _cline_extension_installed(app_dir)
    # Map app → rules writer
    rules_writers = {
        "Windsurf": install_rules_windsurf,
        "Antigravity": install_rules_antigravity,
        "Trae": install_rules_trae,
        "PearAI": install_rules_pearai,
    }
    return AgentDef(
        name=agent_name,
        description=f"Cline inside {app_dir}",
        category="mcp-config",
        install_kind="mcp-http",
        detect=_detect,
        install=_install,
        install_rules=rules_writers.get(app_dir),
        enabled_by_default=True,
    )


for app, slug in [
    ("Windsurf", "windsurf-cline"),
    ("Antigravity", "antigravity-cline"),
    ("Trae", "trae-cline"),
    ("PearAI", "pearai-cline"),
]:
    VSCODE_LIKE_AGENTS.append(_make_vscode_like(app, slug))

AGENTS.extend(VSCODE_LIKE_AGENTS)


# ── Listing & summary ──────────────────────────────────────────────────────

def list_agents() -> None:
    print(f"{C.B}Supported agents{C.R}\n")
    name_w = max(len(a.name) for a in AGENTS) + 2
    for a in sorted(AGENTS, key=lambda x: x.name):
        try:
            detected = a.detect()
        except Exception:
            detected = False
        status = f"{C.GRN}detected{C.R}" if detected else f"{C.DIM}not found{C.R}"
        kind = f"{C.MG}{a.install_kind}{C.R}"
        print(f"  {C.B}{a.name:<{name_w}}{C.R} {status:<18} {kind:<14} {a.description}")
    print()
    print(f"{C.B}Total:{C.R} {len(AGENTS)} agents  |  "
          f"{C.GRN}{sum(1 for a in AGENTS if a.detect())}{C.R} detected on this machine")


def run_for(
    names: list[str],
    *,
    dry_run: bool = False,
    with_rules: bool = True,
    with_skills: bool = False,
    with_hooks: bool = False,
    local: bool = False,
    use_agentmemory: bool = False,
) -> tuple[int, int, list[tuple[str, InstallResult]]]:
    # Stash backend choice so per-agent installers can read it without
    # changing every function signature. Use a thread-safe int.
    import threading
    _backend_state = getattr(run_for, "_state", None)
    if _backend_state is None:
        _backend_state = {"use_agentmemory": False}
        run_for._state = _backend_state
    _backend_state["use_agentmemory"] = use_agentmemory
    os.environ["NEXUS_USE_AGENTMEMORY"] = "1" if use_agentmemory else "0"

    selected: list[AgentDef]
    if not names:
        selected = [a for a in AGENTS if a.detect() and a.enabled_by_default]
    else:
        by_name = {a.name: a for a in AGENTS}
        selected = []
        for n in names:
            if n not in by_name:
                err(f"Unknown agent: {n}")
                return 0, 0, []
            selected.append(by_name[n])

    if not selected:
        warn("No agents matched. Use --list to see all supported agents.")
        return 0, 0, []

    url, secret = get_nexus_env()
    if secret == NEXUS_DEFAULT_SECRET_PLACEHOLDER and not use_agentmemory:
        warn("NEXUS_SECRET is unset — configs will contain a placeholder. "
             "Export NEXUS_SECRET before running agents.")
    info(f"Nexus URL: {url}")
    if use_agentmemory:
        info(f"{C.MG}Backend: @agentmemory/mcp (npm) — alt-backend mode{C.R}")
    info(f"Targeting {len(selected)} agent(s): {', '.join(a.name for a in selected)}")
    flags = []
    if with_rules:
        flags.append("rules")
    if with_skills:
        flags.append("skills")
    if with_hooks:
        flags.append("hooks")
    if local:
        flags.append("local")
    if use_agentmemory:
        flags.append("agentmemory-backend")
    if flags:
        info(f"Also installing: {', '.join(flags)}")
    print()

    results: list[tuple[str, InstallResult]] = []
    succeeded = 0
    failed = 0
    for a in selected:
        if not a.detect():
            warn(f"{a.name}: not detected on this machine (skipping)")
            results.append((a.name, InstallResult(False, "not detected")))
            failed += 1
            continue
        info(f"Installing into {C.B}{a.name}{C.R} ({a.description})...")
        if dry_run:
            dim(f"  would run: {a.install_kind}")
            if with_rules and a.install_rules:
                dim("  would install: rules")
            if with_skills and a.install_skill:
                dim("  would install: skill")
            if with_hooks and a.install_hooks:
                dim("  would install: hooks")
            results.append((a.name, InstallResult(True, "dry-run")))
            succeeded += 1
            continue

        # 1. Connection install
        try:
            r = a.install()
        except Exception as e:
            r = InstallResult(False, f"exception: {e}")
        if r.success:
            ok(f"{a.name} (connection): {r.message}")
            if r.detail:
                dim(r.detail)
            succeeded += 1
        else:
            err(f"{a.name} (connection): {r.message}")
            if r.detail:
                dim(r.detail)
            failed += 1
        results.append((a.name + " (connection)", r))

        # 2. Rules install (global by default)
        if with_rules and a.install_rules:
            try:
                # The rules writer functions take a `local` kwarg
                rr = a.install_rules(local=local)
            except TypeError:
                # Backward-compat: writer doesn't accept local
                rr = a.install_rules()
            except Exception as e:
                rr = InstallResult(False, f"exception: {e}")
            if rr.success:
                ok(f"{a.name} (rules): {rr.message}")
                if rr.detail:
                    dim(rr.detail)
                succeeded += 1
            else:
                err(f"{a.name} (rules): {rr.message}")
                if rr.detail:
                    dim(rr.detail)
                failed += 1
            results.append((a.name + " (rules)", rr))

        # 3. Skills install (opt-in)
        if with_skills and a.install_skill:
            try:
                rs = a.install_skill()
            except Exception as e:
                rs = InstallResult(False, f"exception: {e}")
            if rs.success:
                ok(f"{a.name} (skill): {rs.message}")
                if rs.detail:
                    dim(rs.detail)
                succeeded += 1
            else:
                err(f"{a.name} (skill): {rs.message}")
                if rs.detail:
                    dim(rs.detail)
                failed += 1
            results.append((a.name + " (skill)", rs))

        # 4. Hooks install (opt-in)
        if with_hooks and a.install_hooks:
            try:
                rh = a.install_hooks()
            except Exception as e:
                rh = InstallResult(False, f"exception: {e}")
            if rh.success:
                ok(f"{a.name} (hooks): {rh.message}")
                if rh.detail:
                    dim(rh.detail)
                succeeded += 1
            else:
                err(f"{a.name} (hooks): {rh.message}")
                if rh.detail:
                    dim(rh.detail)
                failed += 1
            results.append((a.name + " (hooks)", rh))

    return succeeded, failed, results


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Install Nexus Memory into AI agents using their native install paths.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""\
examples:
  %(prog)s --list                                show all supported agents + status
  %(prog)s                                       detect & install everything (connection + rules)
  %(prog)s --all                                 install into all supported (skip detection)
  %(prog)s paperclip opencode                    install into specific agents
  %(prog)s --with-skills --with-hooks            also install skills + hooks
  %(prog)s --local                               write rules/skills to project (cwd) instead of global
  %(prog)s --no-rules                            connection only, skip rules
  %(prog)s --use-agentmemory                     wire @agentmemory/mcp as the backend instead of Nexus
  %(prog)s --dry-run                             show what would happen
  NEXUS_URL=http://x:7777 NEXUS_SECRET=abc %(prog)s --all
""",
    )
    parser.add_argument("agents", nargs="*", help="Specific agents to install into (default: detect all)")
    parser.add_argument("--all", action="store_true", help="Install into all supported agents (skip detection)")
    parser.add_argument("--list", action="store_true", help="List supported agents and exit")
    parser.add_argument("--dry-run", action="store_true", help="Show what would happen without writing anything")
    parser.add_argument("--no-color", action="store_true", help="Disable colored output")
    parser.add_argument("--json", action="store_true", help="Output machine-readable summary")
    parser.add_argument("--no-rules", action="store_true", help="Skip the global rules install (connection only)")
    parser.add_argument("--with-skills", action="store_true", help="Also install the Nexus skill (when supported)")
    parser.add_argument("--with-hooks", action="store_true", help="Also install event hooks (when supported)")
    parser.add_argument("--local", action="store_true", help="Write rules/skills to project (cwd) instead of global")
    parser.add_argument("--use-agentmemory", action="store_true",
                        help="Wire @agentmemory/mcp as the memory backend (npm) instead of Nexus. "
                             "Useful for users who want agentmemory's 43-tool surface.")
    args = parser.parse_args()

    C.enable(not args.no_color and sys.stdout.isatty())

    # Plaintext-bearer guard (ported from rohitg00/agentmemory, Apache-2.0):
    # warn once if NEXUS_SECRET is set and NEXUS_URL is plaintext HTTP
    # to a non-loopback host. Set NEXUS_REQUIRE_HTTPS=1 to throw instead.
    try:
        sys.path.insert(0, str(ROOT))
        from integrations._shared.plaintext_bearer_guard import check_plaintext_bearer
        _seen_warning = {"fired": False}

        def _warn_once(msg: str) -> None:
            if _seen_warning["fired"]:
                return
            _seen_warning["fired"] = True
            print(f"{C.YEL}! security:{C.R} {msg}", file=sys.stderr)

        check_plaintext_bearer(
            base_url=os.environ.get("NEXUS_URL", DEFAULT_NEXUS_URL),
            secret=os.environ.get("NEXUS_SECRET", ""),
            warn=_warn_once,
        )
    except RuntimeError:
        raise
    except Exception:
        # guard import failure should never break the installer
        pass

    if args.list:
        list_agents()
        return 0

    if args.all:
        names = [a.name for a in AGENTS]
    else:
        names = args.agents

    succeeded, failed, results = run_for(
        names,
        dry_run=args.dry_run,
        with_rules=not args.no_rules,
        with_skills=args.with_skills,
        with_hooks=args.with_hooks,
        local=args.local,
        use_agentmemory=args.use_agentmemory,
    )

    print()
    if args.json:
        summary = {
            "succeeded": succeeded,
            "failed": failed,
            "results": [
                {"agent": n, "success": r.success, "message": r.message,
                 "detail": r.detail, "changed_paths": r.changed_paths}
                for n, r in results
            ],
        }
        print(json.dumps(summary, indent=2))
    else:
        print(f"{C.B}Summary:{C.R} {C.GRN}{succeeded} ok{C.R}, "
              f"{C.RED}{failed} failed{C.R} of {len(results)} total")
        if failed:
            print()
            print(f"{C.DIM}Tip: ensure the agent is installed on this machine, "
                  f"or use --list to see what is detected.{C.R}")
    return 0 if failed == 0 else 1


if __name__ == "__main__":
    raise SystemExit(main())
