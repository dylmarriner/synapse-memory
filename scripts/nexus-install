#!/usr/bin/env python3
"""Nexus Install — one command, every agent.

Auto-detect which AI agents/IDEs are installed locally and connect them to
Nexus using each agent's native install path where possible (plugin install
API, npm install, etc.) and config-file writes where no install command
exists (most VS Code-style extensions).

Usage:
  scripts/nexus-install                      # detect & install into all
  scripts/nexus-install --list               # show supported agents + status
  scripts/nexus-install paperclip            # install into one agent
  scripts/nexus-install paperclip opencode    # install into several
  scripts/nexus-install --all                # install into every detected
  scripts/nexus-install --dry-run            # show what would happen

Environment:
  NEXUS_URL      Nexus base URL (default: http://100.93.75.87:7777)
  NEXUS_SECRET   Bearer secret for Nexus

The installer never deletes config. Every change is backed up with a
.nexus-backup-<timestamp> suffix.
"""

from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.request
from dataclasses import dataclass, field
from pathlib import Path
from typing import Callable, Optional


ROOT = Path(__file__).resolve().parents[1]
HOME = Path.home()
TS = time.strftime("%Y%m%d-%H%M%S")

DEFAULT_NEXUS_URL = "http://100.93.75.87:7777"
NEXUS_DEFAULT_SECRET_PLACEHOLDER = "${NEXUS_SECRET}"


# ── Output helpers ─────────────────────────────────────────────────────────

class C:
    R = "\033[0m"
    DIM = "\033[2m"
    B = "\033[1m"
    RED = "\033[31m"
    GRN = "\033[32m"
    YEL = "\033[33m"
    BLU = "\033[34m"
    CYN = "\033[36m"
    MG = "\033[35m"

    @classmethod
    def enable(cls, on: bool) -> None:
        if not on:
            for k in ("R", "DIM", "B", "RED", "GRN", "YEL", "BLU", "CYN", "MG"):
                setattr(cls, k, "")


def info(msg: str) -> None:
    print(f"{C.CYN}==>{C.R} {msg}")


def ok(msg: str) -> None:
    print(f"{C.GRN} ✓ {C.R} {msg}")


def warn(msg: str) -> None:
    print(f"{C.YEL} ! {C.R} {msg}")


def err(msg: str) -> None:
    print(f"{C.RED} ✗ {C.R} {msg}", file=sys.stderr)


def dim(msg: str) -> None:
    print(f"{C.DIM}   {msg}{C.R}")


# ── Backup / IO helpers ────────────────────────────────────────────────────

def backup(path: Path) -> Optional[Path]:
    if not path.exists():
        return None
    if path.is_dir():
        target = path.with_name(path.name + f".nexus-backup-{TS}")
        shutil.copytree(path, target)
        return target
    target = path.with_suffix(path.suffix + f".nexus-backup-{TS}")
    shutil.copy2(path, target)
    return target


def write_json(path: Path, data: dict, *, merge: bool = True) -> bool:
    path.parent.mkdir(parents=True, exist_ok=True)
    if merge and path.exists():
        try:
            existing = json.loads(path.read_text(encoding="utf-8"))
        except Exception:
            existing = {}
        if not isinstance(existing, dict):
            existing = {}
        existing = deep_merge(existing, data)
        data = existing
    backup(path)
    path.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")
    return True


def deep_merge(a: dict, b: dict) -> dict:
    out = dict(a)
    for k, v in b.items():
        if k in out and isinstance(out[k], dict) and isinstance(v, dict):
            out[k] = deep_merge(out[k], v)
        else:
            out[k] = v
    return out


def shell(cmd: list[str], timeout: int = 30) -> tuple[int, str, str]:
    try:
        p = subprocess.run(
            cmd, capture_output=True, text=True, timeout=timeout, check=False
        )
        return p.returncode, p.stdout.strip(), p.stderr.strip()
    except FileNotFoundError:
        return 127, "", f"command not found: {cmd[0]}"
    except subprocess.TimeoutExpired:
        return 124, "", "timeout"
    except Exception as e:
        return 1, "", str(e)


def http_post_json(url: str, body: dict, headers: Optional[dict] = None,
                   timeout: int = 15) -> tuple[int, dict | str, str]:
    data = json.dumps(body).encode()
    h = {"Content-Type": "application/json", **(headers or {})}
    req = urllib.request.Request(url, data=data, headers=h, method="POST")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            raw = r.read()
            try:
                return r.status, json.loads(raw), ""
            except Exception:
                return r.status, raw.decode("utf-8", "replace"), ""
    except urllib.error.HTTPError as e:
        body_text = ""
        try:
            body_text = e.read().decode("utf-8", "replace")
        except Exception:
            pass
        return e.code, body_text, body_text
    except Exception as e:
        return 0, "", str(e)


# ── Agent registry ─────────────────────────────────────────────────────────

RULES_PATH = ROOT / "integrations" / "rules" / "nexus-memory.md"
SKILL_PATH = ROOT / "integrations" / "skills" / "nexus-memory" / "SKILL.md"


def _read_rules() -> str:
    return RULES_PATH.read_text(encoding="utf-8") if RULES_PATH.exists() else ""


def _read_skill() -> str:
    return SKILL_PATH.read_text(encoding="utf-8") if SKILL_PATH.exists() else ""


def _read_skill_frontmatter() -> dict:
    if not SKILL_PATH.exists():
        return {}
    text = SKILL_PATH.read_text(encoding="utf-8")
    if not text.startswith("---"):
        return {}
    try:
        end = text.index("---", 3)
        fm = text[3:end].strip()
        # very small YAML-ish parser — we control the format
        out: dict = {}
        for line in fm.splitlines():
            line = line.rstrip()
            if not line or ":" not in line:
                continue
            k, _, v = line.partition(":")
            v = v.strip()
            if v.startswith('"') and v.endswith('"'):
                v = v[1:-1]
            out[k.strip()] = v
        return out
    except Exception:
        return {}


def append_rule_block(path: Path, block_header: str = "## Nexus Memory") -> bool:
    """Append a Nexus Memory section to a markdown rules/instructions file."""
    rules_text = _read_rules()
    if not path.exists():
        path.parent.mkdir(parents=True, exist_ok=True)
        backup(path)
        # If rules_text already starts with the block_header, don't double it
        if rules_text.lstrip().startswith(block_header):
            path.write_text(f"# {path.stem}\n\n{rules_text}", encoding="utf-8")
        else:
            path.write_text(f"# {path.stem}\n\n{block_header}\n\n{rules_text}", encoding="utf-8")
        return True
    text = path.read_text(encoding="utf-8")
    # Detect canonical rules already installed (look for canonical signature)
    if "memory_recall(query=" in text and "memory_save_lesson" in text:
        return False  # already installed (canonical signature present)
    backup(path)
    if text and not text.endswith("\n"):
        text += "\n"
    # Strip any partial/minimal Nexus Memory section (header only with no body)
    if block_header in text and "memory_recall(query=" not in text:
        # remove just the header line, keep the rest
        lines = text.splitlines()
        kept = [l for l in lines if l.strip() != block_header]
        text = "\n".join(kept).rstrip() + "\n"
    if rules_text.lstrip().startswith(block_header):
        path.write_text(text + "\n" + rules_text, encoding="utf-8")
    else:
        path.write_text(text + "\n" + block_header + "\n\n" + rules_text, encoding="utf-8")
    return True


@dataclass
class AgentDef:
    name: str
    description: str
    category: str  # "plugin" | "mcp-config" | "env" | "instructions"
    install_kind: str  # "plugin-api" | "npm" | "mcp-http" | "mcp-stdio" | "config" | "shell" | "copy"
    detect: Callable[[], bool]
    install: Callable[[], InstallResult]
    docs_url: str = ""
    enabled_by_default: bool = True
    # Optional: per-agent rules writer (project-level instructions)
    install_rules: Optional[Callable[[], InstallResult]] = None
    # Optional: per-agent skills writer (skill definition)
    install_skill: Optional[Callable[[], InstallResult]] = None
    # Optional: per-agent hooks writer (event handlers)
    install_hooks: Optional[Callable[[], InstallResult]] = None
    # Whether rules should be installed by default for this agent
    rules_default: bool = True


@dataclass
class InstallResult:
    success: bool
    message: str
    detail: str = ""
    changed_paths: list[str] = field(default_factory=list)


# ── HTTP / MCP snippets ────────────────────────────────────────────────────

def mcp_http_block(url: str, secret: str) -> dict:
    return {
        "url": f"{url.rstrip('/')}/mcp",
        "headers": {"Authorization": f"Bearer {secret}"},
    }


def mcp_stdio_block(url: str, secret: str, agent_id: str) -> dict:
    # Honor --use-agentmemory: wire @agentmemory/mcp instead of Nexus.
    # Both expose the same `memory_recall` / `memory_save` /
    # `memory_smart_search` / `memory_save_lesson` tool surface so
    # the global rules file is portable between backends.
    if os.environ.get("NEXUS_USE_AGENTMEMORY") == "1":
        return {
            "command": "npx",
            "args": ["-y", "@agentmemory/mcp"],
            "env": {
                "AGENTMEMORY_URL": url.rstrip("/"),
                "AGENTMEMORY_SECRET": secret,
                "AGENTMEMORY_TOOLS": "all",
            },
        }
    return {
        "command": "python3",
        "args": [str(ROOT / "scripts" / "adapters" / "nexus_mcp_stdio.py")],
        "env": {
            "NEXUS_URL": url.rstrip("/"),
            "NEXUS_SECRET": secret,
            "NEXUS_AGENT_ID": agent_id,
        },
        "disabled": False,
    }


def mcp_block_for_backend(use_agentmemory: bool, url: str, secret: str, agent_id: str) -> dict:
    """Return MCP server entry for the chosen backend.

    Default backend: Nexus (this repo, `nexus_mcp_stdio.py`).
    Optional: `@agentmemory/mcp` (npm) — wired when `--use-agentmemory`
    is passed. agentmemory uses the same memory_save / memory_recall /
    memory_smart_search tool names so the rules file is portable
    between backends.
    """
    if use_agentmemory:
        return {
            "command": "npx",
            "args": ["-y", "@agentmemory/mcp"],
            "env": {
                "AGENTMEMORY_URL": url.rstrip("/"),
                "AGENTMEMORY_SECRET": secret,
                "AGENTMEMORY_TOOLS": "all",
            },
        }
    return mcp_stdio_block(url, secret, agent_id)


def mcp_stdio_block_with_fallback(url: str, secret: str, agent_id: str) -> dict:
    """MCP block with explicit soft-fail behavior, ported from agentmemory.

    The `fallback_on_error` pattern (origin: rohitg00/agentmemory, Apache-2.0)
    tells agents that prefer resilience over strictness: if the memory
    backend is unreachable, continue without it rather than crash the
    agent run.
    """
    return {
        "command": "python3",
        "args": [str(ROOT / "scripts" / "adapters" / "nexus_mcp_stdio.py")],
        "env": {
            "NEXUS_URL": url.rstrip("/"),
            "NEXUS_SECRET": secret,
            "NEXUS_AGENT_ID": agent_id,
            "NEXUS_FALLBACK_ON_ERROR": "1",
        },
        "disabled": False,
        "metadata": {
            "nexus": {
                "fallback_on_error": True,
                "port": str(ROOT / "scripts" / "adapters" / "nexus_mcp_stdio.py"),
            }
        },
    }


# ── Per-agent installers ──────────────────────────────────────────────────

def get_nexus_env() -> tuple[str, str]:
    url = os.environ.get("NEXUS_URL") or DEFAULT_NEXUS_URL
    secret = os.environ.get("NEXUS_SECRET") or NEXUS_DEFAULT_SECRET_PLACEHOLDER
    return url, secret


# Paperclip — uses /api/plugins/install with package path
def install_paperclip() -> InstallResult:
    url, secret = get_nexus_env()
    package_path = str(ROOT / "paperclip-plugin")
    paperclip_api = "http://127.0.0.1:3100/api/plugins/install"

    # Try the local API endpoint first
    code, body, _ = http_post_json(
        paperclip_api,
        {"packageName": package_path, "isLocalPath": True},
        timeout=20,
    )

    if code in (200, 201):
        return InstallResult(True, "Installed via Paperclip plugin API",
                             detail=str(body)[:200])

    # Fallback: write a config file the Paperclip plugin loader will pick up
    target = HOME / ".config" / "paperclip" / "nexus-memory.json"
    target.parent.mkdir(parents=True, exist_ok=True)
    payload = {
        "pluginId": "nexus-memory",
        "packageName": package_path,
        "isLocalPath": True,
        "instanceConfig": {
            "nexusUrl": url,
            "nexusSecret": secret,
            "agentIdPrefix": "paperclip",
            "defaultLimit": 8,
        },
    }
    backup(target)
    target.write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")
    detail = (
        f"Paperclip API returned {code}; wrote config to {target}. "
        "Run the Paperclip UI to confirm activation, or ensure the gateway is running."
    )
    return InstallResult(code in (200, 201) or code == 0,
                         "Installed via Paperclip config (API fallback)",
                         detail=detail, changed_paths=[str(target)])


# OpenClaw — uses openclaw plugin install API
def install_openclaw() -> InstallResult:
    url, secret = get_nexus_env()
    package_path = str(ROOT / "openclaw-integration" / "extensions" / "nexus-memory")

    # Try the OpenClaw install API (port varies)
    for port in (3110, 3210, 18789, 8888):
        api = f"http://127.0.0.1:{port}/api/plugins/install"
        code, body, errtxt = http_post_json(
            api,
            {"packageName": package_path, "isLocalPath": True},
            timeout=8,
        )
        if code in (200, 201):
            return InstallResult(True, f"Installed via OpenClaw API on :{port}",
                                 detail=str(body)[:200])

    # Fallback: write env + update config.json + copy extension
    env_target = HOME / ".openclaw" / "nexus.env"
    env_target.parent.mkdir(parents=True, exist_ok=True)
    backup(env_target)
    env_target.write_text(
        f"NEXUS_URL={url}\nNEXUS_SECRET={secret}\nNEXUS_AGENT_ID=openclaw\n",
        encoding="utf-8",
    )

    config_target = HOME / ".openclaw" / "openclaw.json"
    if config_target.exists():
        try:
            cfg = json.loads(config_target.read_text(encoding="utf-8"))
        except Exception:
            cfg = {}
        cfg.setdefault("plugins", {}).setdefault("entries", {})["nexus-memory"] = {
            "enabled": True,
            "config": {
                "nexusUrl": url,
                "nexusSecret": secret,
                "agentId": "openclaw",
                "autoCapture": True,
                "autoRecall": True,
            },
        }
        slots = cfg.get("slots", {})
        if isinstance(slots, dict) and slots.get("memory"):
            slots["memory"] = "nexus-memory"
        backup(config_target)
        config_target.write_text(json.dumps(cfg, indent=2) + "\n", encoding="utf-8")
        return InstallResult(True, "Wrote OpenClaw config (API fallback)",
                             detail=f"env + openclaw.json updated; env={env_target}, config={config_target}",
                             changed_paths=[str(env_target), str(config_target)])

    return InstallResult(True, "Wrote OpenClaw env file (no openclaw.json present)",
                         detail=f"Created {env_target}; OpenClaw gateway not detected on common ports.",
                         changed_paths=[str(env_target)])


# OpenCode — uses opencode plugin install (npm) or opencode mcp add
def install_opencode() -> InstallResult:
    url, secret = get_nexus_env()

    # Best path: opencode plugin install (npm-style module)
    if shutil.which("opencode"):
        code, out, errtxt = shell(["opencode", "plugin", "@nexus/memory", "--global"], timeout=30)
        if code == 0:
            return InstallResult(True, "Installed @nexus/memory via opencode plugin install",
                                 detail=out[:200])

    # Second-best: opencode mcp add
    if shutil.which("opencode"):
        code, out, errtxt = shell(
            [
                "opencode", "mcp", "add", "nexus-memory",
                "--url", f"{url.rstrip('/')}/mcp",
                "--header", f"Authorization=Bearer {secret}",
            ],
            timeout=30,
        )
        if code == 0:
            return InstallResult(True, "Registered nexus-memory via opencode mcp add",
                                 detail=out[:200])

    # Fallback: write config file directly
    config_path = HOME / ".config" / "opencode" / "opencode.json"
    config_path.parent.mkdir(parents=True, exist_ok=True)
    if config_path.exists():
        try:
            cfg = json.loads(config_path.read_text(encoding="utf-8"))
        except Exception:
            cfg = {}
    else:
        cfg = {}
    mcp = cfg.get("mcp") if isinstance(cfg.get("mcp"), dict) else {}
    mcp["nexus-memory"] = {
        "type": "remote",
        "url": f"{url.rstrip('/')}/mcp",
        "headers": {"Authorization": f"Bearer {secret}"},
    }
    cfg["mcp"] = mcp
    backup(config_path)
    config_path.write_text(json.dumps(cfg, indent=2) + "\n", encoding="utf-8")
    return InstallResult(True, "Wrote opencode.json (CLI fallback)",
                         detail=f"Added nexus-memory MCP server to {config_path}",
                         changed_paths=[str(config_path)])


# Claude Code — uses `claude plugin install <package>`
def install_claude_code() -> InstallResult:
    url, secret = get_nexus_env()
    package_path = str(ROOT / "integrations" / "plugins" / "claude-code")

    if shutil.which("claude"):
        code, out, errtxt = shell(["claude", "plugin", "install", package_path], timeout=30)
        if code == 0:
            return InstallResult(True, "Installed via `claude plugin install`",
                                 detail=out[:200])

    # Fallback: the rules writer will populate CLAUDE.md — connection alone
    # doesn't need to touch it. Tell the user the plugin is loaded but they
    # should run again with --with-rules to populate the rules file.
    return InstallResult(
        True,
        "Claude CLI not found — connection via MCP. Run with --with-rules to populate CLAUDE.md.",
        detail="Install Claude Code or set `claude` on PATH for full plugin install.",
        changed_paths=[],
    )


# Claude Desktop — writes claude_desktop_config.json
def install_claude_desktop() -> InstallResult:
    url, secret = get_nexus_env()
    target = HOME / ".config" / "Claude" / "claude_desktop_config.json"
    target.parent.mkdir(parents=True, exist_ok=True)
    cfg: dict = {}
    if target.exists():
        try:
            cfg = json.loads(target.read_text(encoding="utf-8"))
        except Exception:
            cfg = {}
    servers = cfg.get("mcpServers") if isinstance(cfg.get("mcpServers"), dict) else {}
    servers["nexus-memory"] = mcp_stdio_block(url, secret, "claude-desktop")
    cfg["mcpServers"] = servers
    backup(target)
    target.write_text(json.dumps(cfg, indent=2) + "\n", encoding="utf-8")
    return InstallResult(True, "Wrote Claude Desktop MCP config",
                         detail=f"Added nexus-memory to {target}",
                         changed_paths=[str(target)])


# Hermes — copies Python plugin into ~/.hermes/.../plugins/memory/nexus/
def install_hermes() -> InstallResult:
    url, secret = get_nexus_env()
    src = ROOT / "integrations" / "plugins" / "hermes-nexus"
    dest = HOME / ".hermes" / "hermes-agent" / "plugins" / "memory" / "nexus"
    dest.parent.mkdir(parents=True, exist_ok=True)
    if dest.exists():
        backup(dest)
    if dest.exists():
        shutil.rmtree(dest)
    shutil.copytree(src, dest)

    # Update config.yaml
    cfg_path = HOME / ".hermes" / "config.yaml"
    if cfg_path.exists():
        try:
            text = cfg_path.read_text(encoding="utf-8")
        except Exception:
            text = ""
        if "provider: nexus" not in text:
            text = text.replace("provider: agentmemory", "provider: nexus")
        if "NEXUS_URL" not in text:
            text += f"\nnexus:\n  url: {url}\n  secret: {secret}\n  agent_id: hermes\n"
        backup(cfg_path)
        cfg_path.write_text(text, encoding="utf-8")

    # Write env file
    env_path = HOME / ".hermes" / "nexus.env"
    env_path.parent.mkdir(parents=True, exist_ok=True)
    backup(env_path)
    env_path.write_text(
        f"NEXUS_URL={url}\nNEXUS_SECRET={secret}\nNEXUS_AGENT_ID=hermes\n",
        encoding="utf-8",
    )
    return InstallResult(True, "Installed Hermes Python plugin",
                         detail=f"Copied to {dest}; env at {env_path}",
                         changed_paths=[str(dest), str(env_path)])


# Cline — writes cline_mcp_settings.json (or its variation per IDE)
def install_cline_global() -> InstallResult:
    url, secret = get_nexus_env()
    target = HOME / ".cline" / "data" / "settings" / "cline_mcp_settings.json"
    target.parent.mkdir(parents=True, exist_ok=True)
    if target.exists():
        try:
            cfg = json.loads(target.read_text(encoding="utf-8"))
        except Exception:
            cfg = {}
    else:
        cfg = {}
    servers = cfg.get("mcpServers") if isinstance(cfg.get("mcpServers"), dict) else {}
    servers["nexus"] = mcp_http_block(url, secret)
    cfg["mcpServers"] = servers
    backup(target)
    target.write_text(json.dumps(cfg, indent=2) + "\n", encoding="utf-8")
    return InstallResult(True, "Wrote Cline MCP config",
                         detail=f"Added nexus to {target}",
                         changed_paths=[str(target)])


# Generic VS Code-compatible extension installer (Cline, Roo, Kilo, Kade in any VS Code-like IDE)
def install_vscode_like(app_dir: str, ext_id: str, settings_rel: str, agent_name: str) -> InstallResult:
    url, secret = get_nexus_env()
    target = HOME / ".config" / app_dir / "User" / "globalStorage" / ext_id / settings_rel
    if not target.parent.exists():
        return InstallResult(False, f"{agent_name} extension not installed",
                             detail=f"Missing {target.parent}")
    target.parent.mkdir(parents=True, exist_ok=True)
    if target.exists():
        try:
            cfg = json.loads(target.read_text(encoding="utf-8"))
        except Exception:
            cfg = {}
    else:
        cfg = {}
    servers = cfg.get("mcpServers") if isinstance(cfg.get("mcpServers"), dict) else {}
    servers["nexus"] = mcp_http_block(url, secret)
    cfg["mcpServers"] = servers
    backup(target)
    target.write_text(json.dumps(cfg, indent=2) + "\n", encoding="utf-8")
    return InstallResult(True, f"Wrote {agent_name} MCP config",
                         detail=f"Added nexus to {target}",
                         changed_paths=[str(target)])


# IDE global MCP configs
def install_ide_mcp(app_dir: str, file_rel: str, agent_name: str, kind: str = "mcpServers") -> InstallResult:
    url, secret = get_nexus_env()
    target = HOME / ".config" / app_dir / file_rel
    if not target.parent.exists():
        return InstallResult(False, f"{agent_name} not installed",
                             detail=f"Missing {target.parent}")
    target.parent.mkdir(parents=True, exist_ok=True)
    if target.exists():
        try:
            cfg = json.loads(target.read_text(encoding="utf-8"))
        except Exception:
            cfg = {}
    else:
        cfg = {}
    block_key = kind
    servers = cfg.get(block_key) if isinstance(cfg.get(block_key), dict) else {}
    servers["nexus"] = mcp_http_block(url, secret)
    cfg[block_key] = servers
    backup(target)
    target.write_text(json.dumps(cfg, indent=2) + "\n", encoding="utf-8")
    return InstallResult(True, f"Wrote {agent_name} MCP config",
                         detail=f"Added nexus to {target}",
                         changed_paths=[str(target)])


# Cursor / VS Code / VSCodium
def install_cursor() -> InstallResult:
    url, secret = get_nexus_env()
    target = HOME / ".cursor" / "mcp.json"
    if not target.parent.exists():
        return InstallResult(False, "Cursor not installed", detail=f"Missing {target.parent}")
    target.parent.mkdir(parents=True, exist_ok=True)
    if target.exists():
        try:
            cfg = json.loads(target.read_text(encoding="utf-8"))
        except Exception:
            cfg = {}
    else:
        cfg = {}
    servers = cfg.get("mcpServers") if isinstance(cfg.get("mcpServers"), dict) else {}
    servers["nexus"] = mcp_http_block(url, secret)
    cfg["mcpServers"] = servers
    backup(target)
    target.write_text(json.dumps(cfg, indent=2) + "\n", encoding="utf-8")
    return InstallResult(True, "Wrote Cursor MCP config",
                         detail=f"Added nexus to {target}",
                         changed_paths=[str(target)])


def install_vscode() -> InstallResult:
    return install_ide_mcp("Code", "User/mcp.json", "VS Code", kind="servers")


def install_vscodium() -> InstallResult:
    return install_ide_mcp("VSCodium", "User/mcp.json", "VSCodium", kind="servers")


