# ── Skills writers (global) ──────────────────────────────────────────────
# Skills are reusable, named instruction sets the LLM can discover. The
# canonical Nexus skill tells the LLM exactly when to recall / save / reflect.

def _write_global_skill(path: Path, agent_name: str) -> InstallResult:
    """Write the canonical Nexus skill to an agent's skills directory."""
    if not _read_skill():
        return InstallResult(False, "Canonical skill file missing",
                             detail=f"Expected {SKILL_PATH}")
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.exists():
        # already installed — leave alone
        return InstallResult(True, f"Skill already present at {path}",
                             detail=str(path), changed_paths=[])
    path.write_text(_read_skill(), encoding="utf-8")
    return InstallResult(True, f"Wrote Nexus skill to {path}",
                         detail=str(path), changed_paths=[str(path)])


def install_skill_claude_code() -> InstallResult:
    return _write_global_skill(HOME / ".claude" / "skills" / "nexus-memory" / "SKILL.md", "claude-code")


def install_skill_opencode() -> InstallResult:
    # OpenCode reads skills from ~/.config/opencode/skills/<name>/SKILL.md (Bun-based)
    return _write_global_skill(HOME / ".config" / "opencode" / "skills" / "nexus-memory" / "SKILL.md", "opencode")


def install_skill_continue() -> InstallResult:
    # Continue skills live in config.yaml; we add a tools/entry instead
    target = HOME / ".continue" / "config.yaml"
    if not target.exists():
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text("version: 0.0.1\n", encoding="utf-8")
    try:
        import yaml  # type: ignore
        data = yaml.safe_load(target.read_text(encoding="utf-8")) or {}
    except ImportError:
        # fallback: small manual edit
        text = target.read_text(encoding="utf-8")
        if "nexus-memory" in text:
            return InstallResult(True, "Continue skill already present", detail=str(target), changed_paths=[])
        backup(target)
        target.write_text(text + "\n# Nexus Memory skill (see ~/.continue/NEXUS.md)\n", encoding="utf-8")
        return InstallResult(True, "Appended note to ~/.continue/config.yaml", detail=str(target), changed_paths=[str(target)])
    except Exception:
        return InstallResult(False, "Could not parse ~/.continue/config.yaml", detail=str(target))
    if not isinstance(data, dict):
        data = {}
    data.setdefault("name", "Continue")
    if "nexus-memory" not in str(data):
        # Continue doesn't have a "skills" concept, but it has slash commands
        cmds = data.setdefault("slashCommands", [])
        if isinstance(cmds, list) and not any(c.get("name") == "nexus" for c in cmds if isinstance(c, dict)):
            cmds.append({
                "name": "nexus",
                "description": "Recall or save Nexus memory (use /nexus recall <query> or /nexus save <content>)",
            })
    backup(target)
    import yaml as _y
    target.write_text(_y.safe_dump(data, sort_keys=False), encoding="utf-8")
    return InstallResult(True, "Added /nexus slash command to ~/.continue/config.yaml",
                         detail=str(target), changed_paths=[str(target)])


# ── Hooks writers (global) ──────────────────────────────────────────────
# Hooks are event-driven automatic actions: pre/post-message recall/save.
# For agents that already implement hooks in their plugin (Paperclip,
# OpenClaw, Hermes, OpenCode plugin), we don't need a separate writer.

def install_hooks_claude_code() -> InstallResult:
    """Add Nexus hooks to ~/.claude/settings.json so every Claude Code session
    auto-recalls before the first prompt and auto-saves after each turn."""
    target = HOME / ".claude" / "settings.json"
    target.parent.mkdir(parents=True, exist_ok=True)
    if target.exists():
        try:
            cfg = json.loads(target.read_text(encoding="utf-8"))
        except Exception:
            cfg = {}
    else:
        cfg = {}
    cfg.setdefault("hooks", {})

    # Point at the existing hook scripts in scripts/hooks/
    hooks_dir = ROOT / "scripts" / "hooks"
    nexus_hooks = {
        "SessionStart": [
            {
                "matcher": "startup|resume|clear|compact",
                "hooks": [
                    {
                        "type": "command",
                        "command": f"python3 {hooks_dir / 'session_start.py'}",
                        "timeout": 10,
                    }
                ],
            }
        ],
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": f"python3 {hooks_dir / 'prompt_recall.py'}",
                        "timeout": 8,
                    }
                ],
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": f"python3 {hooks_dir / 'stop_learn.py'}",
                        "timeout": 10,
                    }
                ],
            }
        ],
    }

    changed = False
    for event, hooks_list in nexus_hooks.items():
        existing = cfg["hooks"].get(event, [])
        if any("nexus" in str(h).lower() or "session_start" in str(h) or "prompt_recall" in str(h) or "stop_learn" in str(h) for h in existing):
            continue
        existing.extend(hooks_list)
        cfg["hooks"][event] = existing
        changed = True

    if changed:
        backup(target)
        target.write_text(json.dumps(cfg, indent=2) + "\n", encoding="utf-8")
    return InstallResult(True, "Wrote Nexus hooks to ~/.claude/settings.json",
                         detail=f"SessionStart + UserPromptSubmit + Stop hooks pointing at scripts/hooks/*.py",
                         changed_paths=[str(target)] if changed else [])


# ── Agent registry ─────────────────────────────────────────────────────────

def _path_exists(p: Path) -> bool:
    return p.exists()


def _which(p: str) -> bool:
    return shutil.which(p) is not None


def _cline_extension_installed(ide_dir: str) -> bool:
    return (HOME / ".config" / ide_dir / "User" / "globalStorage" / "saoudrizwan.claude-dev").exists()


def _any_vscode_extension_installed(ide_dir: str, ext_ids: list[str]) -> bool:
    base = HOME / ".config" / ide_dir / "User" / "globalStorage"
    if not base.exists():
        return False
    return any((base / eid).exists() for eid in ext_ids)


