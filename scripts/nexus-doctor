    return builtin_targets + load_declarative_targets() + discover_vscode_like_targets() + project_instruction_targets()


def connect_target(target: dict[str, Any], url: str, secret: str, apply: bool) -> Finding:
    path = target["path"]
    kind = target["kind"]
    existed = path.exists()
    status = "found" if existed else "missing"

    try:
        if kind in {"mcpServers", "servers"}:
            config = load_json(path)
            transport = target.get("transport", "http")
            server = nexus_mcp_stdio(url, secret, target["agent"]) if transport == "stdio" else nexus_mcp_http(url, secret)
            config = merge_mcp_server(config, kind, server)
            action = write_json(path, config, apply)
            return Finding(target["id"], path, status, f"configured MCP via {transport}", action)

        if kind == "opencode":
            config = merge_opencode(load_json(path), url, secret)
            action = write_json(path, config, apply)
            return Finding(target["id"], path, status, "configured OpenCode local MCP", action)

        if kind == "gemini-settings":
            config = merge_gemini_settings(load_json(path), url, secret)
            action = write_json(path, config, apply)
            return Finding(target["id"], path, status, "configured Gemini/Qwen MCP settings", action)

        if kind == "paperclip":
            config = {
                "nexusUrl": url.rstrip("/"),
                "nexusSecret": secret,
                "agentIdPrefix": "paperclip",
                "defaultLimit": 8,
                "obeliskWrapper": "obelisk",
            }
            action = write_json(path, config, apply)
            return Finding(target["id"], path, status, "wrote Paperclip Nexus config", action)

        if kind == "hermes":
            # 1. Inject MCP server into ~/.hermes/cli-config.yaml
            import re as _re
            hermes_dir = path.parent
            cfg_text = path.read_text(encoding="utf-8") if path.exists() else ""
            mcp_block = (
                f"\nmcp_servers:\n"
                f"  nexus:\n"
                f"    url: {url.rstrip('/')}/mcp\n"
                f"    headers:\n"
                f"      Authorization: \"Bearer {secret}\"\n"
            )
            if "mcp_servers:" not in cfg_text:
                new_cfg = cfg_text + mcp_block
            else:
                # Replace existing nexus block if present
                new_cfg = _re.sub(
                    r"(mcp_servers:.*?)(  nexus:.*?)(?=  \w|\Z)",
                    r"\1" + mcp_block.lstrip("\n").replace("mcp_servers:\n", ""),
                    cfg_text, flags=_re.DOTALL,
                ) if "  nexus:" in cfg_text else cfg_text + mcp_block
            # 2. Write USER.md for passive context injection
            user_md = hermes_dir / "USER.md"
            user_md_marker = "<!-- NEXUS_CONTEXT_START -->"
            user_md_text = user_md.read_text(encoding="utf-8") if user_md.exists() else ""
            if user_md_marker not in user_md_text:
                new_user_md = user_md_text + f"\n{user_md_marker}\n*Nexus active memory will be injected here automatically.*\n<!-- NEXUS_CONTEXT_END -->\n"
            else:
                new_user_md = user_md_text  # push daemon updates this
            # 3. Write session-end hook
            hooks_dir = hermes_dir / "agent-hooks"
            hook_path = hooks_dir / "nexus-session-end.sh"
            _nu = url.rstrip("/")
            hook_script = "\n".join([
                "#!/bin/bash",
                "# Auto-archive Hermes session to Nexus",
                f"NEXUS_URL={_nu}",
                f"NEXUS_SECRET={secret}",
                'SUMMARY="${1:-Hermes session ended}"',
                'curl -sf -X POST "$NEXUS_URL/v1/hooks/trigger"'
                ' -H "Authorization: Bearer $NEXUS_SECRET"'
                ' -H "Content-Type: application/json"'
                ' -d \'{"agent_id":"hermes","event":"session_ended"}\' > /dev/null',
                "",
            ])
            if apply:
                path.parent.mkdir(parents=True, exist_ok=True)
                b = backup(path)
                path.write_text(new_cfg, encoding="utf-8")
                user_md.write_text(new_user_md, encoding="utf-8")
                hooks_dir.mkdir(parents=True, exist_ok=True)
                hook_path.write_text(hook_script, encoding="utf-8")
                hook_path.chmod(0o755)
                action = "written" + (f"; backup={b}" if b else "")
            else:
                action = "dry-run"
            return Finding(target["id"], path, status, "configured Hermes MCP + USER.md + session hook", action)

        if kind == "envfile":
            content = (
                f"NEXUS_URL={url.rstrip('/')}\n"
                f"NEXUS_SECRET={secret}\n"
                f"NEXUS_AGENT_ID={target['agent']}\n"
                f"NEXUS_OBELISK_WRAPPER=obelisk\n"
            )
            if apply:
                path.parent.mkdir(parents=True, exist_ok=True)
                b = backup(path)
                path.write_text(content, encoding="utf-8")
                action = "written" + (f"; backup={b}" if b else "")
            else:
                action = "dry-run"
            return Finding(target["id"], path, status, "wrote env bootstrap", action)

        if kind == "instructions":
            instruction = f"""# Nexus + Obelisk Agent Instructions

Nexus is available for durable memory.

- REST: {url.rstrip('/')}/v1
- MCP: {url.rstrip('/')}/mcp
- Agent ID: {target['agent']}

Use Nexus memory tools for durable preferences, lessons, fixes, decisions, and handoffs.
Use `obelisk <command>` for noisy shell commands when possible.
Do not store raw command noise as memory; save durable summaries/lessons only.
"""
            if apply:
                path.parent.mkdir(parents=True, exist_ok=True)
                b = backup(path)
                existing = path.read_text(encoding="utf-8", errors="replace") if path.exists() else ""
                if "# Nexus + Obelisk Agent Instructions" not in existing:
                    path.write_text((existing.rstrip() + "\n\n" + instruction).lstrip(), encoding="utf-8")
                action = "written" + (f"; backup={b}" if b else "")
            else:
                action = "dry-run"
            return Finding(target["id"], path, status, "wrote agent instructions", action)

        return Finding(target["id"], path, status, f"unsupported target kind {kind}", "skip")
    except Exception as e:
        return Finding(target["id"], path, "error", str(e), "failed")


def health_check(url: str) -> tuple[bool, str]:
    try:
        with urllib.request.urlopen(f"{url.rstrip('/')}/health", timeout=3) as resp:
            return True, resp.read().decode("utf-8", "replace")[:500]
    except Exception as e:
        return False, str(e)


def command_ok(cmd: list[str]) -> tuple[bool, str]:
    try:
        p = subprocess.run(cmd, text=True, capture_output=True, timeout=8)
        return p.returncode == 0, (p.stdout + p.stderr).strip()[:500]
    except Exception as e:
        return False, str(e)


def main() -> int:
    env = parse_env_file(ROOT / ".env")
    parser = argparse.ArgumentParser(description="Scan and auto-connect Nexus to AI agents/IDEs")
    parser.add_argument("--apply", action="store_true", help="write changes; default is scan/dry-run")
    parser.add_argument("--nexus-url", default=os.getenv("NEXUS_URL") or env.get("NEXUS_URL") or f"http://localhost:{env.get('NEXUS_PORT', '7777')}")
    parser.add_argument("--secret", default=os.getenv("NEXUS_SECRET") or env.get("NEXUS_SECRET") or "")
    parser.add_argument("--json", action="store_true", help="emit JSON report")
    args = parser.parse_args()

    report: dict[str, Any] = {
        "mode": "apply" if args.apply else "dry-run",
        "nexus_url": args.nexus_url,
        "root": str(ROOT),
        "checks": {},
        "findings": [],
    }

    ok, detail = health_check(args.nexus_url)
    report["checks"]["nexus_health"] = {"ok": ok, "detail": detail}
    ok, detail = command_ok(["obelisk", "doctor"])
    report["checks"]["obelisk"] = {"ok": ok, "detail": detail}
    ok, detail = command_ok(["obelisk", "run", "git", "status", "--short"])
    report["checks"]["nexus_obelisk_wrapper"] = {"ok": ok, "detail": detail}

    if args.apply and not args.secret:
        print("ERROR: --apply requires NEXUS_SECRET via --secret, env, or .env", file=sys.stderr)
        return 2

    for target in candidate_targets():
        finding = connect_target(target, args.nexus_url, args.secret or "${NEXUS_SECRET}", args.apply)
        report["findings"].append(finding.__dict__ | {"path": str(finding.path)})

    if args.json:
        print(json.dumps(report, indent=2))
    else:
        print("== Nexus Doctor ==")
        print(f"Mode: {report['mode']}")
        print(f"Nexus URL: {args.nexus_url}")
        print("\nChecks:")
        for name, check in report["checks"].items():
            mark = "OK" if check["ok"] else "WARN"
            print(f"  [{mark}] {name}: {check['detail']}")
        print("\nTargets:")
        for f in report["findings"]:
            print(f"  - {f['target']}: {f['status']} → {f['detail']} ({f['action']})")
            print(f"    {f['path']}")
        if not args.apply:
            print("\nDry-run only. Re-run with --apply to write configs. Backups are created automatically.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
