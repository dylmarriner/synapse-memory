    builtin_targets = [
        # Claude family
        {"id": "claude-desktop", "kind": "mcpServers", "path": HOME / ".config" / "Claude" / "claude_desktop_config.json", "agent": "claude-desktop", "transport": "stdio"},
        {"id": "claude-code-settings", "kind": "instructions", "path": HOME / ".claude" / "CLAUDE.md", "agent": "claude-code"},

        # Cline direct + VS Code-like extension storage locations.
        {"id": "cline", "kind": "mcpServers", "path": HOME / ".cline" / "data" / "settings" / "cline_mcp_settings.json", "agent": "cline", "transport": "stdio"},
        {"id": "windsurf-cline", "kind": "mcpServers", "path": HOME / ".config" / "Windsurf" / "User" / "globalStorage" / "saoudrizwan.claude-dev" / "settings" / "cline_mcp_settings.json", "agent": "windsurf-cline", "transport": "http"},
        {"id": "antigravity-cline", "kind": "mcpServers", "path": HOME / ".config" / "Antigravity" / "User" / "globalStorage" / "saoudrizwan.claude-dev" / "settings" / "cline_mcp_settings.json", "agent": "antigravity-cline", "transport": "http"},
        {"id": "trae-cline", "kind": "mcpServers", "path": HOME / ".config" / "Trae" / "User" / "globalStorage" / "saoudrizwan.claude-dev" / "settings" / "cline_mcp_settings.json", "agent": "trae-cline", "transport": "http"},

        # Kade/Kilo style MCP settings inside VS Code-like IDEs.
        {"id": "windsurf-kade", "kind": "mcpServers", "path": HOME / ".config" / "Windsurf" / "User" / "globalStorage" / "kade.kade" / "settings" / "mcp_settings.json", "agent": "windsurf-kade", "transport": "http"},
        {"id": "windsurf-kilocode", "kind": "mcpServers", "path": HOME / ".config" / "Windsurf" / "User" / "globalStorage" / "kilocode.kilo-code" / "settings" / "mcp_settings.json", "agent": "windsurf-kilocode", "transport": "http"},
        {"id": "antigravity-kade", "kind": "mcpServers", "path": HOME / ".config" / "Antigravity" / "User" / "globalStorage" / "kade.kade" / "settings" / "mcp_settings.json", "agent": "antigravity-kade", "transport": "http"},
        {"id": "trae-kade", "kind": "mcpServers", "path": HOME / ".config" / "Trae" / "User" / "globalStorage" / "kade.kade" / "settings" / "mcp_settings.json", "agent": "trae-kade", "transport": "http"},

        # IDE/global MCP files.
        {"id": "windsurf", "kind": "mcpServers", "path": HOME / ".codeium" / "windsurf" / "mcp_config.json", "agent": "windsurf", "transport": "http"},
