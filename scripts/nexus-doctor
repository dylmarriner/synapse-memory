#!/usr/bin/env python3
"""Nexus Doctor — scan, diagnose, and auto-connect AI agents/IDEs.

Default mode is safe scan-only. Use `--apply` to write config changes. Every
changed file is backed up beside the original with a `.nexus-backup-<ts>` suffix.

Examples:
  scripts/nexus-doctor
  scripts/nexus-doctor --apply
  scripts/nexus-doctor --apply --nexus-url http://100.93.75.87:7777 --secret "$NEXUS_SECRET"
"""

from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.request
from dataclasses import dataclass
from pathlib import Path
from typing import Any


ROOT = Path(__file__).resolve().parents[1]
HOME = Path.home()
TS = time.strftime("%Y%m%d-%H%M%S")


@dataclass
class Finding:
    target: str
    path: Path
    status: str
    detail: str
    action: str = ""


def parse_env_file(path: Path) -> dict[str, str]:
    result: dict[str, str] = {}
    if not path.exists():
        return result
    for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        k, v = line.split("=", 1)
        result[k.strip()] = v.strip().strip('"').strip("'")
    return result


def load_json(path: Path) -> dict[str, Any]:
    if not path.exists():
        return {}
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return {}


def backup(path: Path) -> Path | None:
    if not path.exists():
        return None
    backup_path = path.with_name(path.name + f".nexus-backup-{TS}")
    shutil.copy2(path, backup_path)
    return backup_path


def write_json(path: Path, data: dict[str, Any], apply: bool) -> str:
    if not apply:
        return "dry-run"
    path.parent.mkdir(parents=True, exist_ok=True)
    b = backup(path)
    path.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")
    return f"written" + (f"; backup={b}" if b else "")


def expand_path_template(value: str) -> Path:
    return Path(value.format(home=str(HOME), root=str(ROOT), cwd=str(Path.cwd()))).expanduser()


def load_declarative_targets() -> list[dict[str, Any]]:
    registry = ROOT / "integrations" / "doctor" / "targets.json"
    if not registry.exists():
        return []
    try:
        data = json.loads(registry.read_text(encoding="utf-8"))
    except Exception:
        return []
    targets = []
    for raw in data.get("targets", []):
        if not isinstance(raw, dict) or "id" not in raw or "kind" not in raw or "path" not in raw:
            continue
        target = dict(raw)
        target["path"] = expand_path_template(str(raw["path"]))
        target.setdefault("agent", target["id"])
        targets.append(target)
    return targets


def nexus_mcp_http(url: str, secret: str) -> dict[str, Any]:
    return {
        "url": f"{url.rstrip('/')}/mcp",
        "headers": {"Authorization": f"Bearer {secret}"},
    }


def nexus_mcp_stdio(url: str, secret: str, agent_id: str) -> dict[str, Any]:
    return {
        "command": "python3",
        "args": [str(ROOT / "scripts" / "adapters" / "nexus_mcp_stdio.py")],
        "env": {
            "NEXUS_URL": url.rstrip("/"),
            "NEXUS_SECRET": secret,
            "NEXUS_AGENT_ID": agent_id,
        },
        "disabled": False,
    }


def merge_mcp_server(config: dict[str, Any], key: str, server: dict[str, Any]) -> dict[str, Any]:
    current = config.get(key)
    if not isinstance(current, dict):
        current = {}
    current["nexus"] = server
    config[key] = current
    return config


def merge_opencode(config: dict[str, Any], url: str, secret: str) -> dict[str, Any]:
    mcp = config.get("mcp")
    if not isinstance(mcp, dict):
        mcp = {}
    mcp["nexus-memory"] = {
        "type": "local",
        "command": ["python3", str(ROOT / "scripts" / "adapters" / "nexus_mcp_stdio.py")],
        "environment": {
            "NEXUS_URL": url.rstrip("/"),
            "NEXUS_SECRET": secret,
            "NEXUS_AGENT_ID": "opencode",
        },
    }
    config["mcp"] = mcp
    return config


def merge_gemini_settings(config: dict[str, Any], url: str, secret: str) -> dict[str, Any]:
    """Merge Nexus MCP into Gemini/Qwen-style settings.json.

    Gemini CLI documents MCP servers in ~/.gemini/settings.json. Qwen Code is
    derived from Gemini CLI and commonly uses analogous settings. Preserve any
    existing keys and only add/update the `nexus` server.
    """
    servers = config.get("mcpServers")
    if not isinstance(servers, dict):
        servers = {}
    servers["nexus"] = {
        "url": f"{url.rstrip('/')}/mcp",
        "headers": {"Authorization": f"Bearer {secret}"},
    }
    config["mcpServers"] = servers
    return config


def discover_vscode_like_targets() -> list[dict[str, Any]]:
    """Discover known VS Code-compatible AI extension MCP settings."""
    app_dirs = {
        "code": HOME / ".config" / "Code" / "User" / "globalStorage",
        "code-insiders": HOME / ".config" / "Code - Insiders" / "User" / "globalStorage",
        "vscodium": HOME / ".config" / "VSCodium" / "User" / "globalStorage",
        "cursor": HOME / ".config" / "Cursor" / "User" / "globalStorage",
        "windsurf": HOME / ".config" / "Windsurf" / "User" / "globalStorage",
        "antigravity": HOME / ".config" / "Antigravity" / "User" / "globalStorage",
        "trae": HOME / ".config" / "Trae" / "User" / "globalStorage",
        "pearai": HOME / ".config" / "PearAI" / "User" / "globalStorage",
    }
    extension_patterns = {
        "saoudrizwan.claude-dev": ["settings/cline_mcp_settings.json"],
        "rooveterinaryinc.roo-cline": ["settings/mcp_settings.json", "settings/cline_mcp_settings.json"],
        "roo-code": ["settings/mcp_settings.json", "settings/cline_mcp_settings.json"],
        "kilocode.kilo-code": ["settings/mcp_settings.json", "settings/cline_mcp_settings.json"],
        "kade.kade": ["settings/mcp_settings.json"],
    }
    targets: list[dict[str, Any]] = []
    seen: set[Path] = set()
    for app, root in app_dirs.items():
        if not root.exists():
            continue
        for ext_id, rels in extension_patterns.items():
            ext_root = root / ext_id
            if not ext_root.exists():
                continue
            for rel in rels:
                path = ext_root / rel
                if path in seen:
                    continue
                seen.add(path)
                targets.append({
                    "id": f"{app}-{ext_id}",
                    "kind": "mcpServers",
                    "path": path,
                    "agent": f"{app}-{ext_id}",
                    "transport": "http",
                })
    return targets


def project_instruction_targets() -> list[dict[str, Any]]:
    """Instruction files in the current Nexus repo for agent compatibility."""
    cwd = Path.cwd()
    return [
        {"id": "project-agents-md", "kind": "instructions", "path": cwd / "AGENTS.md", "agent": "project-agents"},
        {"id": "project-gemini-md", "kind": "instructions", "path": cwd / "GEMINI.md", "agent": "gemini-cli"},
        {"id": "project-qwen-md", "kind": "instructions", "path": cwd / "QWEN.md", "agent": "qwen-code"},
        {"id": "project-copilot-instructions", "kind": "instructions", "path": cwd / ".github" / "copilot-instructions.md", "agent": "github-copilot"},
        {"id": "project-cursor-rules", "kind": "instructions", "path": cwd / ".cursor" / "rules" / "nexus-memory.mdc", "agent": "cursor"},
        {"id": "project-windsurfrules", "kind": "instructions", "path": cwd / ".windsurfrules", "agent": "windsurf"},
        {"id": "project-clinerules", "kind": "instructions", "path": cwd / ".clinerules", "agent": "cline"},
    ]


