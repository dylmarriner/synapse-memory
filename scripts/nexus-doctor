        {"id": "openhands", "kind": "envfile", "path": HOME / ".openhands" / "nexus.env", "agent": "openhands"},
        {"id": "swe-agent", "kind": "envfile", "path": HOME / ".swe-agent" / "nexus.env", "agent": "swe-agent"},
        {"id": "hermes", "kind": "hermes", "path": HOME / ".hermes" / "cli-config.yaml", "agent": "hermes"},
        {"id": "openclaw", "kind": "envfile", "path": HOME / ".openclaw" / "nexus.env", "agent": "openclaw"},
