#!/usr/bin/env python3
"""Nexus Eval — benchmark recall quality against competitor-beating criteria.

Eval tasks:
  1. preference-recall     — remembers user preference after many sessions
  2. contradiction-recall  — uses latest preference after contradiction
  3. fix-command-recall    — recalls exact fix command for recurring bug
  4. scope-isolation       — distinguishes global vs agent-specific memory
  5. architecture-recall   — retrieves project architecture decision
  6. noise-suppression     — avoids injecting irrelevant memories
  7. symbol-recall         — retrieves function signature/return type from code memory
  8. bug-fix-chain         — retrieves root cause from multi-step debug session
  9. cross-file-ref        — retrieves cross-file architecture dependency
  10. agent-scope-bleed    — 3-agent shared project, verify correct scoping

LongMemEval-S format (--eval-format longmemeval-s --input FILE.json):
  Input JSON: [{question, answer, conversation_history: [{role, content}]}]
  Output: {"total": N, "correct": N, "accuracy": float, "samples": [...]}

Usage:
  scripts/nexus-eval
  NEXUS_URL=http://localhost:7777 NEXUS_SECRET=... scripts/nexus-eval
  scripts/nexus-eval --task preference-recall
  scripts/nexus-eval --verbose
  scripts/nexus-eval --eval-format longmemeval-s --input samples.json
  scripts/nexus-eval --json
"""

from __future__ import annotations

import argparse
import difflib
import json
import os
import sys
import time
import urllib.error
import urllib.request
from dataclasses import dataclass, field
from typing import Any, Optional


NEXUS_URL = os.environ.get("NEXUS_URL", "http://localhost:7777")
NEXUS_SECRET = os.environ.get("NEXUS_SECRET", "")
EVAL_AGENT = "nexus-eval-agent"
VERBOSE = False

PASS = "PASS"
FAIL = "FAIL"
SKIP = "SKIP"


@dataclass
class EvalResult:
    task: str
    status: str
    detail: str = ""
    latency_ms: float = 0.0
    score: float = 0.0


def api(method: str, path: str, body: Any = None) -> Any:
    url = f"{NEXUS_URL}{path}"
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(
        url,
        data=data,
        headers={
            "Authorization": f"Bearer {NEXUS_SECRET}",
            "Content-Type": "application/json",
        },
        method=method,
    )
    try:
        with urllib.request.urlopen(req, timeout=15) as resp:
            return json.loads(resp.read())
    except urllib.error.HTTPError as e:
        raise RuntimeError(f"HTTP {e.code} {method} {path}: {e.read().decode()[:200]}")


def save(content: str, agent_id: str = EVAL_AGENT, memory_type: str = "preference", importance: float = 0.7) -> str:
    r = api("POST", "/v1/memory/save", {
        "content": content,
        "agent_id": agent_id,
        "memory_type": memory_type,
        "importance": importance,
    })
    return r["id"]


def recall(query: str, agent_id: Optional[str] = EVAL_AGENT, limit: int = 5) -> list[dict]:
    r = api("POST", "/v1/memory/recall", {
        "query": query,
        "agent_id": agent_id,
        "limit": limit,
    })
    return r.get("results", [])


def delete_agent_memories(agent_id: str = EVAL_AGENT):
    """Best-effort cleanup: delete all memories for the eval agent."""
    try:
        rows = api("GET", f"/v1/browse/memories?agent={agent_id}&limit=200")
        for m in rows.get("memories", []):
            try:
                api("DELETE", f"/v1/browse/memories/{m['id']}")
            except Exception:
                pass
    except Exception:
        pass


def _contains(results: list[dict], keyword: str) -> bool:
    kw = keyword.lower()
    return any(kw in r.get("content", "").lower() for r in results)


def _top_content(results: list[dict]) -> str:
    if not results:
        return ""
    return results[0].get("content", "")


def _similarity(a: str, b: str) -> float:
    """Simple token overlap similarity score 0.0–1.0."""
    return difflib.SequenceMatcher(None, a.lower(), b.lower()).ratio()


# ── Eval tasks ───────────────────────────────────────────────────────────────

def eval_preference_recall() -> EvalResult:
    """Save a preference, then save many unrelated memories, then recall it."""
    pref = "The user prefers dark mode with Solarized Dark theme at font size 16."
    save(pref, memory_type="preference", importance=0.8)
    for i in range(8):
        save(f"User opened file number {i} in the project explorer.", memory_type="observation", importance=0.3)

    t0 = time.monotonic()
    results = recall("user interface theme preference")
    latency_ms = (time.monotonic() - t0) * 1000

    if _contains(results, "solarized"):
        return EvalResult("preference-recall", PASS, "Solarized preference recalled correctly", latency_ms, 1.0)
    if _contains(results, "dark mode"):
        return EvalResult("preference-recall", PASS, "Dark mode preference recalled (partial)", latency_ms, 0.7)
    return EvalResult("preference-recall", FAIL, f"Preference not recalled. Top: {_top_content(results)[:120]}", latency_ms, 0.0)


def eval_contradiction_recall() -> EvalResult:
    """Save a preference, then contradict it, then verify the latest is recalled."""
    save("The user prefers Python 3.9 as the runtime version.", memory_type="preference", importance=0.7)
    time.sleep(0.1)
    save("The user now prefers Python 3.12 as the runtime version. Previous preference for 3.9 is superseded.", memory_type="preference", importance=0.85)

    t0 = time.monotonic()
    results = recall("Python runtime version preference")
    latency_ms = (time.monotonic() - t0) * 1000

    if _contains(results, "3.12"):
        return EvalResult("contradiction-recall", PASS, "Latest preference (3.12) recalled", latency_ms, 1.0)
    if _contains(results, "3.9") and not _contains(results, "3.12"):
        return EvalResult("contradiction-recall", FAIL, "Stale preference returned instead of updated one", latency_ms, 0.0)
    return EvalResult("contradiction-recall", FAIL, f"Unexpected result. Top: {_top_content(results)[:120]}", latency_ms, 0.0)


def eval_fix_command_recall() -> EvalResult:
    """Store a recurring fix command and verify exact retrieval."""
    fix = "Fix: when pytest fails with 'address already in use', run `lsof -ti:5432 | xargs kill -9` then retry."
    save(fix, memory_type="lesson", importance=0.9)

    t0 = time.monotonic()
    results = recall("pytest address already in use port error fix")
    latency_ms = (time.monotonic() - t0) * 1000

    if _contains(results, "lsof"):
        return EvalResult("fix-command-recall", PASS, "Fix command recalled correctly", latency_ms, 1.0)
    if _contains(results, "5432") or _contains(results, "kill"):
        return EvalResult("fix-command-recall", PASS, "Fix command partially recalled", latency_ms, 0.7)
    return EvalResult("fix-command-recall", FAIL, f"Fix command not recalled. Top: {_top_content(results)[:120]}", latency_ms, 0.0)


def eval_scope_isolation() -> EvalResult:
    """Global vs agent-specific memories should not bleed across agents."""
    agent_a = f"{EVAL_AGENT}-agent-a"
    agent_b = f"{EVAL_AGENT}-agent-b"

    save("Agent A prefers to use pytest for all test runs.", agent_id=agent_a, memory_type="preference")
    save("Agent B prefers to use jest for all test runs.", agent_id=agent_b, memory_type="preference")

    t0 = time.monotonic()
    results_a = recall("test runner preference", agent_id=agent_a)
    latency_ms = (time.monotonic() - t0) * 1000

    has_pytest = _contains(results_a, "pytest")
    has_jest = _contains(results_a, "jest") and not _contains(results_a, "pytest")

    for ag in [agent_a, agent_b]:
        try:
            rows = api("GET", f"/v1/browse/memories?agent={ag}&limit=50")
            for m in rows.get("memories", []):
                api("DELETE", f"/v1/browse/memories/{m['id']}")
        except Exception:
            pass

    if has_pytest and not has_jest:
        return EvalResult("scope-isolation", PASS, "Agent-specific memory scoped correctly", latency_ms, 1.0)
    if has_jest:
        return EvalResult("scope-isolation", FAIL, "Agent B memory leaked into Agent A recall", latency_ms, 0.0)
    return EvalResult("scope-isolation", FAIL, f"No scoped memory found. Top: {_top_content(results_a)[:120]}", latency_ms, 0.0)


def eval_architecture_recall() -> EvalResult:
    """Store an architecture decision and verify it can be retrieved."""
    arch = (
        "Architecture decision: we use PostgreSQL with pgvector for the memory store "
        "because it supports vector similarity, full-text search, and JSONB natively "
        "without requiring a separate vector database service."
    )
    save(arch, memory_type="world", importance=0.85)

    t0 = time.monotonic()
    results = recall("why do we use PostgreSQL for the memory store")
    latency_ms = (time.monotonic() - t0) * 1000

    if _contains(results, "pgvector"):
        return EvalResult("architecture-recall", PASS, "Architecture decision recalled with pgvector detail", latency_ms, 1.0)
    if _contains(results, "postgresql") or _contains(results, "postgres"):
        return EvalResult("architecture-recall", PASS, "Architecture decision recalled (partial)", latency_ms, 0.7)
    return EvalResult("architecture-recall", FAIL, f"Architecture decision not recalled. Top: {_top_content(results)[:120]}", latency_ms, 0.0)


def eval_noise_suppression() -> EvalResult:
    """Irrelevant memories should not dominate the recall results for a specific query."""
    for i in range(10):
        save(f"User typed a command in the terminal at step {i}.", memory_type="observation", importance=0.2)
    save("The database schema uses UUID primary keys for all tables.", memory_type="world", importance=0.5)

    t0 = time.monotonic()
    results = recall("database schema primary key type")
    latency_ms = (time.monotonic() - t0) * 1000

    if _contains(results, "uuid"):
        return EvalResult("noise-suppression", PASS, "Relevant memory surfaced despite noise", latency_ms, 1.0)
    noisy_top = _contains(results[:2], "terminal") or _contains(results[:2], "command")
    if noisy_top:
        return EvalResult("noise-suppression", FAIL, "Noisy observations dominated recall", latency_ms, 0.0)
    return EvalResult("noise-suppression", FAIL, f"Relevant memory not in top results. Top: {_top_content(results)[:120]}", latency_ms, 0.0)


# ── Coding-specific eval tasks ────────────────────────────────────────────────

def eval_symbol_recall() -> EvalResult:
    """Store function signatures, then recall a specific function's return type."""
    signatures = [
        "Function `parse_config(path: str) -> dict`: reads a YAML config file and returns a dict of settings.",
        "Function `build_index(docs: list[str]) -> VectorIndex`: embeds documents and builds a pgvector index.",
        "Function `run_migrations(engine) -> None`: applies all pending Alembic migrations to the database.",
        "Function `get_embedding(text: str) -> list[float]`: calls fastembed to produce a 384-dim vector.",
        "Function `recall_memories(query: str, agent_id: str, limit: int) -> list[Memory]`: runs 4-mode fused recall.",
        "Function `contradict_memory(old_id: UUID, new_id: UUID, db) -> None`: marks old memory superseded.",
        "Function `compress_context(memories: list, token_budget: int) -> str`: truncates to token budget.",
        "Function `extract_entities(content: str, llm) -> list[Entity]`: NER extraction via LLM prompt.",
        "Function `consolidate(db) -> ConsolidationStats`: deduplicates and decays importance scores.",
        "Function `schedule_job(queue: str, payload: dict, redis) -> str`: pushes a job onto Redis queue.",
    ]
    for sig in signatures:
        save(sig, memory_type="world", importance=0.75)

    t0 = time.monotonic()
    results = recall("what does parse_config return")
    latency_ms = (time.monotonic() - t0) * 1000

    if _contains(results, "parse_config") and _contains(results, "dict"):
        return EvalResult("symbol-recall", PASS, "parse_config signature recalled with return type", latency_ms, 1.0)
    if _contains(results, "parse_config"):
        return EvalResult("symbol-recall", PASS, "parse_config recalled (return type missing)", latency_ms, 0.6)
    return EvalResult("symbol-recall", FAIL, f"parse_config not recalled. Top: {_top_content(results)[:120]}", latency_ms, 0.0)


def eval_bug_fix_chain() -> EvalResult:
    """Store a multi-step debug session; recall the root cause."""
    steps = [
        "Debug step 1: the server crashes on startup with 'relation embeddings does not exist'.",
        "Debug step 2: checked migrations — the embeddings column was added in migration 003 but not applied.",
        "Debug step 3: ran `alembic upgrade head` but it failed with 'target database is not up to date'.",
        "Debug step 4: discovered the database had been restored from a backup that predated migration 002.",
        "Root cause: backup restore skipped two migrations. Fix: run `alembic stamp 001` then `alembic upgrade head`.",
    ]
    for step in steps:
        save(step, memory_type="lesson", importance=0.8)

    t0 = time.monotonic()
    results = recall("why does the server crash with relation embeddings does not exist")
    latency_ms = (time.monotonic() - t0) * 1000

    if _contains(results, "backup") and (_contains(results, "migration") or _contains(results, "alembic")):
        return EvalResult("bug-fix-chain", PASS, "Root cause (backup + migration) recalled correctly", latency_ms, 1.0)
    if _contains(results, "migration") or _contains(results, "alembic"):
        return EvalResult("bug-fix-chain", PASS, "Migration cause recalled (backup detail missing)", latency_ms, 0.6)
    return EvalResult("bug-fix-chain", FAIL, f"Root cause not recalled. Top: {_top_content(results)[:120]}", latency_ms, 0.0)


def eval_cross_file_ref() -> EvalResult:
    """Store architecture facts across multiple conceptual files; recall a dependency."""
    facts = [
        "app/routers/memory.py imports app/search/fusion.py for reciprocal rank fusion after multi-mode search.",
        "app/search/fusion.py depends on app/models/api.py for the MemoryResult type.",
        "app/memory/extract.py imports app/embeddings.py to generate vectors before storing memories.",
        "app/main.py registers all routers: memory, agents, sessions, synapse, admin, browse, compat.",
        "app/config.py is imported by every module that needs settings — it is the single config source of truth.",
    ]
    for fact in facts:
        save(fact, memory_type="world", importance=0.8)

    t0 = time.monotonic()
    results = recall("what does the memory router depend on for ranking results")
    latency_ms = (time.monotonic() - t0) * 1000

    if _contains(results, "fusion") or _contains(results, "reciprocal"):
        return EvalResult("cross-file-ref", PASS, "Cross-file dependency (fusion) recalled correctly", latency_ms, 1.0)
    if _contains(results, "memory.py") or _contains(results, "search"):
        return EvalResult("cross-file-ref", PASS, "Partial dependency recalled", latency_ms, 0.5)
    return EvalResult("cross-file-ref", FAIL, f"Dependency not recalled. Top: {_top_content(results)[:120]}", latency_ms, 0.0)


def eval_agent_scope_bleed() -> EvalResult:
    """3 agents share a project name; verify memories don't bleed between agents."""
    agent_x = f"{EVAL_AGENT}-proj-x"
    agent_y = f"{EVAL_AGENT}-proj-y"
    agent_z = f"{EVAL_AGENT}-proj-z"

    save("Agent X uses black for Python code formatting with line length 88.", agent_id=agent_x, memory_type="preference")
    save("Agent Y uses ruff for Python code formatting with line length 100.", agent_id=agent_y, memory_type="preference")
    save("Agent Z uses autopep8 for Python code formatting with line length 79.", agent_id=agent_z, memory_type="preference")

    t0 = time.monotonic()
    results_x = recall("Python code formatting tool preference", agent_id=agent_x, limit=3)
    latency_ms = (time.monotonic() - t0) * 1000

    has_black = _contains(results_x, "black")
    has_ruff = _contains(results_x, "ruff")
    has_autopep8 = _contains(results_x, "autopep8")

    for ag in [agent_x, agent_y, agent_z]:
        delete_agent_memories(ag)

    if has_black and not has_ruff and not has_autopep8:
        return EvalResult("agent-scope-bleed", PASS, "Agent X memory isolated; no bleed from Y or Z", latency_ms, 1.0)
    if has_ruff or has_autopep8:
        leaked = []
        if has_ruff:
            leaked.append("Y(ruff)")
        if has_autopep8:
            leaked.append("Z(autopep8)")
        return EvalResult("agent-scope-bleed", FAIL, f"Memory leaked from agent(s): {', '.join(leaked)}", latency_ms, 0.0)
    return EvalResult("agent-scope-bleed", FAIL, f"No scoped memory found. Top: {_top_content(results_x)[:120]}", latency_ms, 0.0)


ALL_TASKS = {
    "preference-recall": eval_preference_recall,
    "contradiction-recall": eval_contradiction_recall,
    "fix-command-recall": eval_fix_command_recall,
    "scope-isolation": eval_scope_isolation,
    "architecture-recall": eval_architecture_recall,
    "noise-suppression": eval_noise_suppression,
    "symbol-recall": eval_symbol_recall,
    "bug-fix-chain": eval_bug_fix_chain,
    "cross-file-ref": eval_cross_file_ref,
    "agent-scope-bleed": eval_agent_scope_bleed,
}


# ── LongMemEval-S adapter ─────────────────────────────────────────────────────

def run_longmemeval_s(input_file: str, no_cleanup: bool = False) -> dict:
    """Run LongMemEval-S benchmark from a JSON input file.

    Input format: [{question, answer, conversation_history: [{role, content}]}]
    Each sample's conversation_history is ingested as memories, then recalled
    using the question; result is scored against the expected answer.
    """
    try:
        with open(input_file) as f:
            samples = json.load(f)
    except (OSError, json.JSONDecodeError) as e:
        print(f"ERROR: Cannot load {input_file}: {e}", file=sys.stderr)
        sys.exit(1)

    if not isinstance(samples, list):
        print("ERROR: LongMemEval-S input must be a JSON array", file=sys.stderr)
        sys.exit(1)

    lme_agent = f"{EVAL_AGENT}-longmemeval"
    results = []
    correct = 0

    for i, sample in enumerate(samples):
        question = sample.get("question", "")
        expected = sample.get("answer", "")
        history = sample.get("conversation_history", [])

        if not question or not expected:
            if VERBOSE:
                print(f"  Sample {i}: skipping (missing question or answer)", flush=True)
            continue

        # Ingest conversation history as memories
        for turn in history:
            role = turn.get("role", "user")
            content = turn.get("content", "")
            if content:
                save(
                    f"[{role}] {content}",
                    agent_id=lme_agent,
                    memory_type="observation",
                    importance=0.6,
                )

        # Recall and score
        t0 = time.monotonic()
        recalled = recall(question, agent_id=lme_agent, limit=5)
        latency_ms = (time.monotonic() - t0) * 1000

        # Score: check if any recalled memory contains the expected answer
        top = _top_content(recalled)
        sim = _similarity(top, expected)
        exact_hit = expected.lower() in " ".join(r.get("content", "") for r in recalled).lower()
        score = 1.0 if exact_hit else (sim if sim > 0.5 else 0.0)
        passed = score >= 0.5

        if passed:
            correct += 1

        results.append({
            "index": i,
            "question": question[:100],
            "expected": expected[:100],
            "top_recalled": top[:100],
            "score": round(score, 3),
            "latency_ms": round(latency_ms),
            "passed": passed,
        })

        if VERBOSE:
            icon = "✓" if passed else "✗"
            print(f"  {icon} [{i}] score={score:.2f} {question[:60]}", flush=True)

        if not no_cleanup:
            delete_agent_memories(lme_agent)

    total = len(results)
    accuracy = correct / total if total else 0.0
    output = {
        "total": total,
        "correct": correct,
        "accuracy": round(accuracy, 4),
        "avg_latency_ms": round(sum(r["latency_ms"] for r in results) / total) if total else 0,
        "samples": results,
    }
    return output


# ── Runner ────────────────────────────────────────────────────────────────────

def run_task(name: str, fn) -> EvalResult:
    try:
        result = fn()
    except Exception as e:
        result = EvalResult(name, FAIL, f"Exception: {e}")
    return result


def main():
    global VERBOSE

    parser = argparse.ArgumentParser(description="Nexus eval — recall quality benchmarks")
    parser.add_argument("--task", choices=list(ALL_TASKS), help="Run only this task")
    parser.add_argument("--verbose", action="store_true")
    parser.add_argument("--no-cleanup", action="store_true", help="Skip pre/post memory cleanup")
    parser.add_argument("--json", action="store_true", help="Output results as JSON")
    parser.add_argument(
        "--eval-format",
        choices=["nexus", "longmemeval-s"],
        default="nexus",
        help="Eval format: nexus (built-in tasks) or longmemeval-s (external JSON file)",
    )
    parser.add_argument(
        "--input",
        metavar="FILE",
        help="Input file for --eval-format longmemeval-s",
    )
    args = parser.parse_args()
    VERBOSE = args.verbose

    if not NEXUS_SECRET:
        print("ERROR: NEXUS_SECRET not set", file=sys.stderr)
        sys.exit(1)

    try:
        api("GET", "/health")
    except Exception as e:
        print(f"ERROR: Cannot reach Nexus at {NEXUS_URL}: {e}", file=sys.stderr)
        sys.exit(1)

    # ── LongMemEval-S mode ────────────────────────────────────────────────────
    if args.eval_format == "longmemeval-s":
        if not args.input:
            print("ERROR: --input FILE required for --eval-format longmemeval-s", file=sys.stderr)
            sys.exit(1)
        output = run_longmemeval_s(args.input, no_cleanup=args.no_cleanup)
        if args.json:
            print(json.dumps(output, indent=2))
        else:
            acc_pct = output["accuracy"] * 100
            print(f"\n  LongMemEval-S: {output['correct']}/{output['total']} correct  |  accuracy {acc_pct:.1f}%  |  avg latency {output['avg_latency_ms']}ms")
            if output["accuracy"] < 0.9:
                sys.exit(1)
        return

    # ── Built-in nexus tasks ──────────────────────────────────────────────────
    tasks = {args.task: ALL_TASKS[args.task]} if args.task else ALL_TASKS

    if not args.no_cleanup:
        delete_agent_memories()

    results: list[EvalResult] = []
    for name, fn in tasks.items():
        if VERBOSE:
            print(f"  Running {name}…", flush=True)
        r = run_task(name, fn)
        results.append(r)
        if not args.json:
            status_icon = "✓" if r.status == PASS else ("?" if r.status == SKIP else "✗")
            print(f"  {status_icon} {r.task:<28} {r.status:<5}  {r.latency_ms:>6.0f}ms  {r.detail[:80]}")

    if not args.no_cleanup:
        delete_agent_memories()

    passed = sum(1 for r in results if r.status == PASS)
    failed = sum(1 for r in results if r.status == FAIL)
    skipped = sum(1 for r in results if r.status == SKIP)
    avg_score = sum(r.score for r in results) / len(results) if results else 0.0

    if args.json:
        print(json.dumps({
            "passed": passed, "failed": failed, "skipped": skipped,
            "avg_score": round(avg_score, 3),
            "results": [
                {"task": r.task, "status": r.status, "detail": r.detail,
                 "latency_ms": round(r.latency_ms), "score": r.score}
                for r in results
            ],
        }, indent=2))
    else:
        print(f"\n  Results: {passed} passed / {failed} failed / {skipped} skipped  |  avg score {avg_score:.2f}")
        if failed:
            sys.exit(1)


if __name__ == "__main__":
    main()
