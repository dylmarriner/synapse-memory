# ═══════════════════════════════════════════════════════════
# Nexus — Unified Agent Memory Server
#
# Tailscale IP: 100.93.75.87
# REST:  http://100.93.75.87:7777/v1
# MCP:   http://100.93.75.87:7777/mcp
# Docs:  http://100.93.75.87:7777/docs
# ═══════════════════════════════════════════════════════════

# Master API key — agents include this as: Authorization: Bearer <key>
NEXUS_SECRET=change-me-generate-a-strong-random-key
NEXUS_PORT=7777

# Database
POSTGRES_PASSWORD=nexuspassword

# LLM providers (optional — enables classification, entity extraction, reflection)
# DeepSeek is tried first, then OpenAI, then Anthropic
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model overrides
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMS=384
LLM_MODEL=deepseek-chat

# Token/cost controls
# Keep query expansion off by default because it adds an LLM call to recall.
LLM_COST_SAVER=true
LLM_INPUT_CHAR_LIMIT=1200
LLM_EXTRACT_MAX_TOKENS=180
LLM_SUMMARY_MAX_TOKENS=220
LLM_REFLECT_MAX_TOKENS=300
LLM_SYNTHESIS_MAX_TOKENS=450
LLM_QUERY_EXPANSION=false
LLM_QUERY_EXPANSION_MIN_CHARS=80
CONTEXT_MEMORY_LIMIT=20
CONTEXT_MEMORY_CHAR_LIMIT=500
CONTEXT_CONCLUSION_LIMIT=8

# Learning pipeline
LEARNING_INTERVAL=300

# CORS (comma-separated origins, empty = allow all)
CORS_ORIGINS=
